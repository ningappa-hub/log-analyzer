# Copy this file to .env before running the backend locally.
# Do not commit backend/.env with real secrets.

DATABASE_URL=sqlite:///./logs.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# Optional: set one of these to enable AI analysis.
# Leave them commented out for demo mode.
# GEMINI_API_KEY=replace-with-your-real-key
# GOOGLE_API_KEY=replace-with-your-real-key

# Optional legacy fallback if you wire it up later.
# OPENAI_API_KEY=replace-with-your-real-key